[Unit]
Description=Gas Town Daemon
After=network.target

[Service]
Type=simple
ExecStart={{.GTPath}} daemon run
WorkingDirectory={{.TownRoot}}
Restart=always
RestartSec=5s
Environment="GT_TOWN_ROOT={{.TownRoot}}"
StandardOutput=append:{{.TownRoot}}/daemon/daemon.log
StandardError=append:{{.TownRoot}}/daemon/daemon.log
# KillMode=mixed: SIGTERM the main gt process only, then SIGKILL the cgroup at
# timeout. The daemon spawns claude agents via tmux-spawn-<uuid>.scope sibling
# cgroups; with the default control-group KillMode, systemd tries to signal
# every process in the service cgroup including transiently-adopted children,
# which intermittently fails with "Failed to kill control group: Invalid
# argument" and strands the unit in 'failed' state. Mixed mode lets the
# daemon's own graceful shutdown drain its bd children cleanly.
KillMode=mixed
TimeoutStopSec=30s

[Install]
WantedBy=default.target
