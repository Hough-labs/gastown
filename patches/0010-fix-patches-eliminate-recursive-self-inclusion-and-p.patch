From add5f6ebccf005eb073dde458e8354eba264018e Mon Sep 17 00:00:00 2001
From: Hunter B Hough <git@hough.ink>
Date: Thu, 16 Apr 2026 19:20:48 -0400
Subject: [PATCH 10/35] fix(patches): eliminate recursive self-inclusion and
 pre-push amend bug
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Same fix as beads — two compounding bugs:
1. format-patch included patches/ dir, causing recursive bloat
2. Pre-push amend changed SHA after git captured push range, causing
   perpetual local/origin divergence

Fix: pathspec exclusion in format-patch, validation-only pre-push check.
Patches drop from 9.8k → 1k total lines.

Co-Authored-By: Claude Opus 4.6 <noreply@anthropic.com>
(cherry picked from commit 8290d0f8d3158662e23a4bbd0a3010983bdab9c7)
---
 .githooks/pre-push | 37 +++++++++++++++++++++++++++++++++----
 Makefile           |  2 +-
 2 files changed, 34 insertions(+), 5 deletions(-)

diff --git a/.githooks/pre-push b/.githooks/pre-push
index 1214db61..d9fcef8b 100755
--- a/.githooks/pre-push
+++ b/.githooks/pre-push
@@ -1,14 +1,43 @@
 #!/bin/bash
 # Pre-push hook — two responsibilities:
 #
-# 1. On anvil branch: regenerate patches/ and fold into HEAD before pushing.
-#    Ensures patches/ always reflects the current divergence from upstream/main.
+# 1. On anvil branch: validate patches/ is current before pushing.
 #
 # 2. On all branches: enforce Gas Town branch policy and integration guardrails.
 #    (Upstream logic — do not remove.)
 
-# Note: patches/ is managed manually. Before pushing new commits from anvil, run:
-#   make patches && git add patches/ && git commit --amend --no-edit
+# ── Anvil branch: validate patches/ is up-to-date ───────────────────────────
+BRANCH_NAME=$(git symbolic-ref --short HEAD 2>/dev/null || echo "")
+if [ "$BRANCH_NAME" = "anvil" ]; then
+    PATCH_TMPDIR=$(mktemp -d)
+    git format-patch upstream/main..HEAD --output-directory "$PATCH_TMPDIR" -- . ':!patches/' >/dev/null 2>&1
+    EXPECTED=$(ls "$PATCH_TMPDIR"/*.patch 2>/dev/null | wc -l | tr -d ' ')
+    ACTUAL=$(ls patches/*.patch 2>/dev/null | wc -l | tr -d ' ')
+    if [ "$EXPECTED" != "$ACTUAL" ]; then
+        rm -rf "$PATCH_TMPDIR"
+        echo ""
+        echo "pre-push: patches/ has $ACTUAL patches but $EXPECTED expected. Run:"
+        echo "  make patches && git add patches/ && git commit --amend --no-edit"
+        echo "Then push again."
+        exit 1
+    fi
+    STALE=0
+    for f in "$PATCH_TMPDIR"/*.patch; do
+        base=$(basename "$f")
+        if [ ! -f "patches/$base" ] || ! diff <(tail -n +2 "patches/$base") <(tail -n +2 "$f") >/dev/null 2>&1; then
+            STALE=1
+            break
+        fi
+    done
+    rm -rf "$PATCH_TMPDIR"
+    if [ "$STALE" = "1" ]; then
+        echo ""
+        echo "pre-push: patches/ is stale. Run:"
+        echo "  make patches && git add patches/ && git commit --amend --no-edit"
+        echo "Then push again."
+        exit 1
+    fi
+fi
 
 # ── Gas Town branch policy ────────────────────────────────────────────────────
 
diff --git a/Makefile b/Makefile
index 00db14e9..156bb585 100644
--- a/Makefile
+++ b/Makefile
@@ -196,7 +196,7 @@ check-version-tag:
 patches:
 	@echo "Exporting patches from anvil -> upstream/main divergence..."
 	@rm -f patches/*.patch
-	@git format-patch upstream/main..HEAD --output-directory patches/
+	@git format-patch upstream/main..HEAD --output-directory patches/ -- . ':!patches/'
 	@echo "Patches written to patches/:"
 	@ls patches/*.patch 2>/dev/null | sed 's|patches/||'
 
