From 968846dabe433ca3119beba3969bf258c6289274 Mon Sep 17 00:00:00 2001
From: Hunter B Hough <git@hough.ink>
Date: Mon, 6 Apr 2026 05:23:18 -0400
Subject: [PATCH 01/34] chore: gitignore mantle-compiled agent config dirs
 (.claude, .agents, .pi)

These are generated by `mantle persona build` and should not be committed.

Co-Authored-By: Claude Sonnet 4.6 <noreply@anthropic.com>
---
 .gitignore | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/.gitignore b/.gitignore
index 5c322f0a..eb336c96 100644
--- a/.gitignore
+++ b/.gitignore
@@ -96,3 +96,7 @@ CLAUDE.local.md
 
 # Fork research notes (private — not for public upstream)
 docs/fork-info/
+
+# Mantle-compiled agent config (generated, do not commit)
+.agents/
+.pi/
-- 
2.50.1 (Apple Git-155)

