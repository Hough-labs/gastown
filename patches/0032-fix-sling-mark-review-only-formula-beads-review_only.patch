From 09a0b063b1e461c60647b34440c171743f42f234 Mon Sep 17 00:00:00 2001
From: Hunter B Hough <git@hough.ink>
Date: Wed, 8 Jul 2026 17:01:11 -0400
Subject: [PATCH 32/70] fix(sling): mark review-only formula beads review_only
 so gt done skips verified_push gate (gfork-06a)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

A reviewer dispatched with mol-polecat-review-pr posts its GitHub review and runs
`gt done`, which takes the no-MR completion path and applies a verified_push gate
(done.go). Reviewers make zero code commits, yet the gate demands HEAD be on
origin/master — so it fails whenever the reviewer's HEAD is not an ancestor of the
current tip (reviewer reuse with an orphaned base, or a squash-merge discarding the
base), wedging the reviewer and holding a polecat slot.

The gate already has an escape: done.go skips it when the bead is review_only
(af.NoMerge || af.ReviewOnly). But that field never reached mol-polecat-review-pr
reviewer beads:
  1. The formula lacked the `review_only = true` marker its siblings declare
     (mol-plan-review, mol-prd-review, mol-polecat-code-review).
  2. Even with the marker, formula-level review_only only propagated via the
     convoy-leg path (buildConvoyLegSlingArgs); the single-reviewer / scheduler
     dispatch set the bead's ReviewOnly only from the --review-only flag.

Fix:
  - Declare `review_only = true` in mol-polecat-review-pr.formula.toml.
  - In storeFieldsInBead (the single attachment-field write chokepoint for every
    dispatch route), derive review_only from the attached formula so a formula that
    declares it stamps its bead regardless of dispatch path.

Marking these beads review_only also correctly classifies them as
merge-queue-not-required (mqNotRequiredSource), matching mol-polecat-code-review.

Discovered by Gassy's android require_review=true test run; characterized on an-1af.
Provenance: upstream gap (review-only wired for convoy legs + manual flag but never
for single-reviewer PR dispatch).

Co-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>
---
 internal/cmd/sling_helpers.go                 | 31 +++++++
 internal/cmd/sling_review_only_test.go        | 92 +++++++++++++++++++
 .../mol-polecat-review-pr.formula.toml        |  2 +
 3 files changed, 125 insertions(+)
 create mode 100644 internal/cmd/sling_review_only_test.go

diff --git a/internal/cmd/sling_helpers.go b/internal/cmd/sling_helpers.go
index 61c3e8dd..489ef864 100644
--- a/internal/cmd/sling_helpers.go
+++ b/internal/cmd/sling_helpers.go
@@ -658,6 +658,15 @@ func storeFieldsInBeadFromTownRoot(townRoot, beadID string, updates beadFieldUpd
 	if updates.ReviewOnly {
 		fields.ReviewOnly = true
 	}
+	// A formula that declares review_only=true marks its bead review_only on every
+	// dispatch route. Convoy legs already OR this in (buildConvoyLegSlingArgs), but
+	// the single-reviewer / scheduler dispatch did not — so an iris-dispatched
+	// mol-polecat-review-pr reviewer never got the field and wedged gt done's
+	// verified_push gate (gfork-06a). Keyed on AttachedFormula, which is always set
+	// at dispatch time.
+	if !fields.ReviewOnly && formulaDeclaresReviewOnly(fields.AttachedFormula) {
+		fields.ReviewOnly = true
+	}
 	if updates.Mode != nil {
 		fields.Mode = *updates.Mode
 	}
@@ -696,6 +705,28 @@ func storeFieldsInBeadFromTownRoot(townRoot, beadID string, updates beadFieldUpd
 	return nil
 }
 
+// formulaDeclaresReviewOnly reports whether the named formula sets
+// review_only=true at the top level (e.g. mol-polecat-review-pr,
+// mol-polecat-code-review). This lets any dispatch path — not just convoy legs
+// (see buildConvoyLegSlingArgs) — mark a reviewer's bead review_only, so gt done's
+// no-MR completion skips the verified_push gate for a worker that produced no
+// mergeable commits (gfork-06a). Best-effort: any load/parse failure returns
+// false, and callers fall back to the explicit --review-only flag.
+func formulaDeclaresReviewOnly(name string) bool {
+	if name == "" {
+		return false
+	}
+	content, err := formula.GetEmbeddedFormulaContent(name)
+	if err != nil {
+		return false
+	}
+	f, err := formula.Parse(content)
+	if err != nil {
+		return false
+	}
+	return f.ReviewOnly
+}
