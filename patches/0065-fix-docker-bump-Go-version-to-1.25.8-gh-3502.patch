From 45b9b4b105c72957a1040dabbe91bbc019321e07 Mon Sep 17 00:00:00 2001
From: nux <steve.yegge@gmail.com>
Date: Sun, 12 Apr 2026 16:42:59 -0700
Subject: [PATCH 065/110] fix(docker): bump Go version to 1.25.8 (gh#3502)

Dockerfile pinned GO_VERSION=1.25.6, but go.mod requires 1.25.8 and
beads@v0.63.3 also requires >=1.25.8, so `make build` failed with
"module requires go >= 1.25.8 (running go 1.25.6)".
---
 Dockerfile | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/Dockerfile b/Dockerfile
index c401a216..0f3950b7 100644
--- a/Dockerfile
+++ b/Dockerfile
@@ -2,7 +2,7 @@
 # docker build -t gastown:latest -f Dockerfile .
 FROM docker/sandbox-templates:claude-code
 
-ARG GO_VERSION=1.25.6
+ARG GO_VERSION=1.25.8
 
 USER root
 
-- 
2.43.0

