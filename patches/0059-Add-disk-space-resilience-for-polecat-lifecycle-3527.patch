+
+func TestDiskSpaceLevel_String(t *testing.T) {
+	tests := []struct {
+		level DiskSpaceLevel
+		want  string
+	}{
+		{DiskSpaceOK, "ok"},
+		{DiskSpaceWarning, "warning"},
+		{DiskSpaceCritical, "critical"},
+		{DiskSpaceLevel(99), "unknown"},
