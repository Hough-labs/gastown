From 28ddffbca85fa8232007f740efd0ff1d15d303c3 Mon Sep 17 00:00:00 2001
From: Maarten Thoelen <maarten.thoelen@hatchsoftware.be>
Date: Sun, 12 Apr 2026 22:21:49 +0200
Subject: [PATCH 001/110] fix(daemon): show failure reason when daemon fails to
 start (#3586)

When the daemon fails to start, the error message now includes the
actual failure reason from logs when available, or suggests checking
logs with 'gt daemon logs' as a fallback.

Co-authored-by: maartenthoelen <maarten.thoelen@hatch.be>
---
 internal/cmd/up.go | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/internal/cmd/up.go b/internal/cmd/up.go
index d19e6ad8..a3a4dd70 100644
--- a/internal/cmd/up.go
+++ b/internal/cmd/up.go
@@ -559,7 +559,10 @@ func ensureDaemon(townRoot string) error {
 		return err
 	}
 	if !running {
-		return fmt.Errorf("daemon failed to start")
+		if msg := readDaemonStartupFailure(townRoot, cmd.Process.Pid); msg != "" {
+			return fmt.Errorf("daemon failed to start: %s", msg)
+		}
+		return fmt.Errorf("daemon failed to start (check logs with 'gt daemon logs')")
 	}
 
 	return nil
