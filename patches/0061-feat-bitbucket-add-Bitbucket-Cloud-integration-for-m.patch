+func TestMergePR(t *testing.T) {
+	t.Parallel()
+	mux := http.NewServeMux()
+	mux.HandleFunc("POST /repositories/myws/myrepo/pullrequests/42/merge", func(w http.ResponseWriter, r *http.Request) {
+		var body map[string]any
