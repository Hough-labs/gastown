From 00d095523cbbb4448515059d42b8ace6557738f3 Mon Sep 17 00:00:00 2001
From: Hunter B Hough <git@hough.ink>
Date: Sat, 18 Jul 2026 15:03:21 -0400
Subject: [PATCH 46/64] beads: point fork tracker at gfork DB (renamed from
 gastown-fork)

The fork's beads DB was consolidated from 'gastown-fork' to 'gfork' so
the Dolt database name matches the gfork rig name (gt rig-config-sync
requires db-name == rig-name). metadata.json (gitignored) already
points at gfork; this updates the tracked source config so fresh clones
resolve correctly.

Co-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>
---
 .beads/config.yaml | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/.beads/config.yaml b/.beads/config.yaml
index a84521b3..6fca2f59 100644
--- a/.beads/config.yaml
+++ b/.beads/config.yaml
@@ -48,14 +48,14 @@ dolt.idle-timeout: "0"
 # regressions when the bd binary is upgraded. (gt-b48)
 export.auto: "false"
 # Fork-local tracker — a normal project, SEPARATE from the gastown hq/~/gt town
-# (whose DB is 'hq'/prefix 'hq'). Prefix 'gfork', database 'gastown-fork' on the
+# (whose DB is 'hq'/prefix 'hq'). Prefix 'gfork', database 'gfork' on the
 # hammer:3307 Dolt server (bastion-backed), mirroring ~/code/gauntlet's setup.
 # The prior 677-issue 'gt-*' history is preserved on Hough-labs/gastown
 # refs/dolt/data + .beads/backup/; not imported into this fresh tracker.
 dolt.mode: "server"
 dolt.host: 127.0.0.1
 dolt.port: 3307
-dolt.database: "gastown-fork"
+dolt.database: "gfork"
 dolt.auto-start: false
 dolt.auto-push: "off"
 sync.remote: "git+ssh://git@github.com/Hough-labs/gastown.git"
-- 
2.50.1 (Apple Git-155)

