From 2001d2beb58d378b5c388b1595a30d5b17d91d1c Mon Sep 17 00:00:00 2001
From: Hunter B Hough <git@hough.ink>
Date: Tue, 7 Apr 2026 15:04:25 -0400
Subject: [PATCH 07/17] fix(doltserver): persist GT_DOLT_HOST via daemon.env
 fallback
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Mirrors the existing GT_DOLT_LOGLEVEL fallback so daemon-triggered
Dolt restarts pick up the configured bind host. Without this, after
the daemon restarts dolt (crash recovery, etc.), the host setting is
lost and dolt rebinds to localhost — breaking any non-loopback
clients (Tailscale, LAN).
---
 internal/doltserver/doltserver.go | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/internal/doltserver/doltserver.go b/internal/doltserver/doltserver.go
index efcc9cd4..fa2a56d9 100644
--- a/internal/doltserver/doltserver.go
+++ b/internal/doltserver/doltserver.go
@@ -277,6 +277,14 @@ func DefaultConfig(townRoot string) *Config {
 
 	if h := os.Getenv("GT_DOLT_HOST"); h != "" {
 		config.Host = h
+	} else if townRoot != "" {
+		// Fallback: read GT_DOLT_HOST from daemon/daemon.env so the bind host
+		// survives daemon-triggered Dolt restarts (mirrors GT_DOLT_LOGLEVEL
+		// fallback below). Without this, a daemon restart would silently
+		// rebind dolt to localhost and break cross-machine clients.
+		if h := readDaemonEnvVar(filepath.Join(townRoot, "daemon", "daemon.env"), "GT_DOLT_HOST"); h != "" {
+			config.Host = h
+		}
 	}
 
 	// Port precedence: config.yaml > env var > default
