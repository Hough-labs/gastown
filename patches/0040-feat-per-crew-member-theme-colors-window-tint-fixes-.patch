+		{"#000000", 0.4, "#000000"},
+		{"default", 0.4, "#default"}, // non-hex passthrough
+	}
+	for _, tt := range tests {
+		t.Run(tt.hex, func(t *testing.T) {
+			got := DarkenColor(tt.hex, tt.factor)
