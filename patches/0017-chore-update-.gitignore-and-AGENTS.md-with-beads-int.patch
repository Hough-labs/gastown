diff --git a/.beads/.gitignore b/.beads/.gitignore
index aef2b5b9..eb82c48f 100644
--- a/.beads/.gitignore
+++ b/.beads/.gitignore
@@ -1,6 +1,5 @@
 # Dolt database (managed by Dolt, not git)
