From eaec3eb659857c51116c511f8201e4930179130f Mon Sep 17 00:00:00 2001
From: Hunter B Hough <git@hough.ink>
Date: Thu, 16 Apr 2026 19:03:38 -0400
Subject: [PATCH 14/28] build: sweep mise cleanup; regen patches + sync Anvil
 on push
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Three changes to make anvil-branch pushes converge both machines on
the same binary without a separate deploy step:

1. Drop the stale-binary cleanup loop for ~/.local/share/mise/installs/go/*
   — mise is uninstalled so this is dead code. Kept the ~/.local/bin sweep.

2. Pre-push hook now regenerates patches/ and folds into HEAD on the
   anvil branch, matching beads. Prior version relied on the operator
   running make patches manually.

3. After the local make install, background a poll-and-trigger job that
   waits for origin/anvil to advance to the pushed SHA, then SSHes anvil
   to pull+build. Log at ~/.cache/sync-anvil.log; failure is non-fatal.

Pre-push install step runs with SKIP_UPDATE_CHECK=1 because after the
patches amend, local HEAD is ahead of origin/anvil (this push is the
thing that advances origin).

Co-Authored-By: Claude Opus 4.7 <noreply@anthropic.com>
---
 .githooks/pre-push | 54 ++++++++++++++++++++++++++++++++++++++++------
 Makefile           | 17 ++-------------
 2 files changed, 50 insertions(+), 21 deletions(-)

diff --git a/.githooks/pre-push b/.githooks/pre-push
index 1214db61..bcd5f0a7 100755
--- a/.githooks/pre-push
+++ b/.githooks/pre-push
@@ -1,14 +1,27 @@
 #!/bin/bash
-# Pre-push hook — two responsibilities:
+# Pre-push hook — three responsibilities:
 #
-# 1. On anvil branch: regenerate patches/ and fold into HEAD before pushing.
-#    Ensures patches/ always reflects the current divergence from upstream/main.
+# 1. On anvil branch: regenerate patches/ and fold into HEAD, rebuild+install
+#    locally, then kick off a remote rebuild on Anvil so both machines converge.
 #
 # 2. On all branches: enforce Gas Town branch policy and integration guardrails.
 #    (Upstream logic — do not remove.)
+#
+# 3. After upstream policy checks pass: rebuild and install.
 
-# Note: patches/ is managed manually. Before pushing new commits from anvil, run:
-#   make patches && git add patches/ && git commit --amend --no-edit
+# ── Anvil branch housekeeping: regenerate patches/ and fold into HEAD ────────
+BRANCH_NAME=$(git symbolic-ref --short HEAD 2>/dev/null || echo "")
+if [ "$BRANCH_NAME" = "anvil" ]; then
+    if ! make patches --quiet; then
+        echo "pre-push: make patches failed" >&2
+        exit 1
+    fi
+    if ! git diff --quiet patches/; then
+        git add patches/
+        git commit --amend --no-edit --quiet
+        echo "pre-push: patches/ refreshed and folded into HEAD"
+    fi
+fi
 
 # ── Gas Town branch policy ────────────────────────────────────────────────────
 
@@ -109,7 +122,36 @@ while read local_ref local_sha remote_ref remote_sha; do
 done
 
 # --- Build and install to ~/go/bin ---
+# After amending HEAD with patches/, local is ahead of origin/anvil, so bypass
+# the up-to-date guard (we're the ones advancing origin via this push).
 echo "gastown: rebuilding and installing to ~/go/bin..."
-make install
+SKIP_UPDATE_CHECK=1 make install
+
+# --- Sync to Anvil ---
+# Only trigger from Hammer (Darwin) on anvil branch. Background job polls
+# origin/anvil until it sees our pushed SHA, then SSHes anvil to pull+build.
+# Failure is logged, not fatal — the local push still succeeds.
+if [ "$BRANCH_NAME" = "anvil" ] && [ "$(uname -s)" = "Darwin" ]; then
+    EXPECTED_SHA=$(git rev-parse HEAD)
+    LOG="$HOME/.cache/sync-anvil.log"
+    mkdir -p "$(dirname "$LOG")"
+    (
+        exec >>"$LOG" 2>&1
+        echo "[$(date '+%F %T')] gastown sync-anvil: waiting for origin/anvil to reach $EXPECTED_SHA"
+        for _ in $(seq 1 30); do
+            REMOTE_SHA=$(git ls-remote --quiet origin refs/heads/anvil 2>/dev/null | awk '{print $1}')
+            if [ "$REMOTE_SHA" = "$EXPECTED_SHA" ]; then
+                echo "[$(date '+%F %T')] gastown sync-anvil: origin reached $EXPECTED_SHA — triggering remote build"
+                ssh -o BatchMode=yes anvil "cd ~/code/forks/gastownhall/gastown && git fetch origin anvil --quiet && git reset --hard origin/anvil --quiet && make install"
+                echo "[$(date '+%F %T')] gastown sync-anvil: done"
+                exit 0
+            fi
+            sleep 2
+        done
+        echo "[$(date '+%F %T')] gastown sync-anvil: timeout — origin/anvil did not advance. Run manually on anvil: cd ~/code/forks/gastownhall/gastown && git pull && make install"
+    ) </dev/null &
+    disown
+    echo "pre-push: anvil sync backgrounded (tail $LOG for progress)"
+fi
 
 exit 0
diff --git a/Makefile b/Makefile
index 22701dd1..fe549abd 100644
--- a/Makefile
+++ b/Makefile
@@ -96,20 +96,13 @@ install: check-up-to-date build
 	@mkdir -p $(INSTALL_DIR)
 	@rm -f $(INSTALL_DIR)/$(BINARY)
 	@cp $(BUILD_DIR)/$(BINARY) $(INSTALL_DIR)/$(BINARY)
-	@# Nuke any stale binaries from previous install locations (including mise Go paths)
+	@# Sweep stale binaries from the upstream default install location.
 	@for bad in $(HOME)/bin/$(BINARY) $(HOME)/.local/bin/$(BINARY); do \
 		if [ -f "$$bad" ] && [ "$$bad" != "$(INSTALL_DIR)/$(BINARY)" ]; then \
 			echo "Removing stale $$bad"; \
 			rm -f "$$bad"; \
 		fi; \
 	done
-	@# Remove from all mise Go version shims
-	@for bad in $(HOME)/.local/share/mise/installs/go/*/bin/$(BINARY); do \
-		if [ -f "$$bad" ]; then \
-			echo "Removing stale mise binary $$bad"; \
-			rm -f "$$bad"; \
-		fi; \
-	done
 	@echo "Installed $(BINARY) to $(INSTALL_DIR)/$(BINARY)"
 	@# Restart daemon so it picks up the new binary.
 	@# A stale daemon is a recurring source of bugs (wrong session prefixes, etc.)
@@ -134,19 +127,13 @@ safe-install: check-up-to-date check-forward-only build
 	@# Atomic-ish replace: copy to temp then move (move is atomic on same filesystem)
 	@cp $(BUILD_DIR)/$(BINARY) $(INSTALL_DIR)/$(BINARY).new
 	@mv $(INSTALL_DIR)/$(BINARY).new $(INSTALL_DIR)/$(BINARY)
-	@# Nuke any stale binaries from previous install locations (including mise Go paths)
+	@# Sweep stale binaries from the upstream default install location.
 	@for bad in $(HOME)/bin/$(BINARY) $(HOME)/.local/bin/$(BINARY); do \
 		if [ -f "$$bad" ] && [ "$$bad" != "$(INSTALL_DIR)/$(BINARY)" ]; then \
 			echo "Removing stale $$bad"; \
 			rm -f "$$bad"; \
 		fi; \
 	done
-	@for bad in $(HOME)/.local/share/mise/installs/go/*/bin/$(BINARY); do \
-		if [ -f "$$bad" ]; then \
-			echo "Removing stale mise binary $$bad"; \
-			rm -f "$$bad"; \
-		fi; \
-	done
 	@echo "Installed $(BINARY) to $(INSTALL_DIR)/$(BINARY) (daemon NOT restarted)"
 	@echo "Sessions will pick up new binary on next cycle."
 
