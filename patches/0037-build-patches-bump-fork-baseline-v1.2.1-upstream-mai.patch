From e29893e73c9063335b20cd89d6422bea84bab26b Mon Sep 17 00:00:00 2001
From: Hunter B Hough <git@hough.ink>
Date: Thu, 9 Jul 2026 15:47:10 -0400
Subject: [PATCH 37/75] build(patches): bump fork baseline v1.2.1 ->
 upstream/main 81233d36
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

No upstream release tag exists past v1.2.1, so the baseline is now pinned to an
upstream/main SHA. The fork was rebased onto it (gfork-owt.4) to pick up beads
v1.0.5's dependency-schema migration (depends_on_id split into typed columns),
which our code already runs against — self-inflicted version skew, resolved by
moving forward rather than reverting beads.

Bumps UPSTREAM_BASE in both the Makefile and .githooks/pre-push.

Co-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>
---
 .githooks/pre-push |  6 +++---
 Makefile           | 10 ++++++----
 2 files changed, 9 insertions(+), 7 deletions(-)

diff --git a/.githooks/pre-push b/.githooks/pre-push
index af66cbb8..276de4e2 100755
--- a/.githooks/pre-push
+++ b/.githooks/pre-push
@@ -7,9 +7,9 @@
 #    (Upstream logic — do not remove.)
 
 # ── Anvil branch: validate patches/ is up-to-date ───────────────────────────
-# Baseline tag this fork tracks. Keep in sync with UPSTREAM_BASE in the Makefile;
-# bump both on every upstream upgrade.
-UPSTREAM_BASE="v1.2.1"
+# Baseline this fork tracks (an upstream/main SHA — no tag exists past v1.2.1).
+# Keep in sync with UPSTREAM_BASE in the Makefile; bump both on every upstream upgrade.
+UPSTREAM_BASE="81233d36f27465fcae83944f78bdea1674d7143e"
 BRANCH_NAME=$(git symbolic-ref --short HEAD 2>/dev/null || echo "")
 if [ "$BRANCH_NAME" = "anvil" ]; then
     PATCH_TMPDIR=$(mktemp -d)
diff --git a/Makefile b/Makefile
index 4071a42a..6df32caf 100644
--- a/Makefile
+++ b/Makefile
@@ -190,10 +190,12 @@ check-version-tag:
 	fi; \
 	echo "check-version-tag: OK (tag $$TAG matches Version=$$CODE_VERSION)"
 
-# Upstream baseline this fork tracks. We pin to a release TAG (not upstream/main)
-# because main diverges from release tags. Bump this on every upstream upgrade
-# (and the matching ref in .githooks/pre-push), then rebase patches onto it.
-UPSTREAM_BASE := v1.2.1
+# Upstream baseline this fork tracks. Normally a release TAG, but there is no
+# tag past v1.2.1, so we pin to an upstream/main SHA (the fork was rebased onto
+# it to pick up the beads v1.0.5 dependency-schema migration). Bump this on every
+# upstream upgrade (and the matching ref in .githooks/pre-push), then rebase
+# patches onto it. The SHA must be fetched/reachable for `make patches`.
+UPSTREAM_BASE := 81233d36f27465fcae83944f78bdea1674d7143e
 
 # Export current local commits (UPSTREAM_BASE..HEAD divergence) to patches/.
 # Run this after adding or editing a local patch commit.
-- 
