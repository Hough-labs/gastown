From 21e27463cba44ba762e555a8bab817d31d17cfec Mon Sep 17 00:00:00 2001
From: Pierre-Alexandre Entraygues <paentraygues@gmail.com>
Date: Sun, 12 Apr 2026 22:22:56 +0200
Subject: [PATCH 007/110] fix(formula): resolve deps in rigBeadsDir, not
 townBeads (#3528)

Steps and legs are created in the rig's beads directory but dependency
resolution was still running against the town beads directory, causing
"no issue found" errors on freshly created beads.

Regression from de3d6b96 which moved bead creation to rigBeadsDir but
missed updating the dep add commands that follow.

Co-authored-by: Claude Opus 4.6 (1M context) <noreply@anthropic.com>
---
 internal/cmd/formula.go | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/internal/cmd/formula.go b/internal/cmd/formula.go
index 5bd1466b..691977bc 100644
--- a/internal/cmd/formula.go
+++ b/internal/cmd/formula.go
@@ -639,7 +639,7 @@ func executeConvoyFormula(f *formula.Formula, formulaName, targetRig string) err
 			for _, legBeadID := range legBeads {
 				_ = BdCmd("dep", "add", synthesisBeadID, legBeadID).
 					WithAutoCommit().
-					Dir(townBeads).
+					Dir(rigBeadsDir).
 					Run()
 			}
 
@@ -823,7 +823,7 @@ func executeWorkflowFormula(f *formula.Formula, formulaName, targetRig string) e
 			}
 			_ = BdCmd("dep", "add", stepBeadID, depBeadID).
 				WithAutoCommit().
-				Dir(townBeads).
+				Dir(rigBeadsDir).
 				Run()
 		}
 
-- 
2.43.0

