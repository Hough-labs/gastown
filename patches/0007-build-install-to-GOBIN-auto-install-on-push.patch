From 369056f1f393a6ded81a124b8f241272c6e2f170 Mon Sep 17 00:00:00 2001
From: Hunter B Hough <git@hough.ink>
Date: Fri, 10 Apr 2026 12:19:09 -0400
Subject: [PATCH 07/37] build: install to GOBIN, auto-install on push

INSTALL_DIR now uses go env GOBIN with ~/go/bin fallback.
Pre-push hook runs make install after branch policy checks.
Cleans stale copies from ~/.local/bin.

Co-Authored-By: Claude Opus 4.6 <noreply@anthropic.com>
(cherry picked from commit 70880c6118ace18a68938f13c97112d4a55d396e)
---
 .githooks/pre-push |  4 ++++
 Makefile           | 21 ++++++++++++---------
 2 files changed, 16 insertions(+), 9 deletions(-)

diff --git a/.githooks/pre-push b/.githooks/pre-push
index 24a14eb9..f88eb77d 100755
--- a/.githooks/pre-push
+++ b/.githooks/pre-push
@@ -108,4 +108,8 @@ while read local_ref local_sha remote_ref remote_sha; do
   fi
 done
 
+# --- Build and install to mise GOBIN ---
+echo "gastown: rebuilding and installing to mise..."
+make install
+
 exit 0
diff --git a/Makefile b/Makefile
index b140d47b..f5250b9d 100644
--- a/Makefile
+++ b/Makefile
@@ -3,7 +3,10 @@
 BINARY := gt
 BINARY_DESKTOP := gt-desktop
 BUILD_DIR := .
-INSTALL_DIR := $(HOME)/.local/bin
+INSTALL_DIR := $(shell go env GOBIN)
+ifeq ($(INSTALL_DIR),)
+INSTALL_DIR := $(HOME)/go/bin
+endif
 E2E_IMAGE ?= gastown-test
 E2E_BUILD_FLAGS ?=
 E2E_RUN_FLAGS ?= --rm
@@ -104,10 +107,10 @@ install: check-up-to-date build
 	@mkdir -p $(INSTALL_DIR)
 	@rm -f $(INSTALL_DIR)/$(BINARY)
 	@cp $(BUILD_DIR)/$(BINARY) $(INSTALL_DIR)/$(BINARY)
-	@# Nuke any stale go-install binaries that shadow the canonical location
-	@for bad in $(HOME)/go/bin/$(BINARY) $(HOME)/bin/$(BINARY); do \
-		if [ -f "$$bad" ]; then \
-			echo "Removing stale $$bad (use make install, not go install)"; \
+	@# Nuke any stale binaries from previous install locations
+	@for bad in $(HOME)/go/bin/$(BINARY) $(HOME)/bin/$(BINARY) $(HOME)/.local/bin/$(BINARY); do \
+		if [ -f "$$bad" ] && [ "$$bad" != "$(INSTALL_DIR)/$(BINARY)" ]; then \
+			echo "Removing stale $$bad"; \
 			rm -f "$$bad"; \
 		fi; \
 	done
@@ -136,10 +139,10 @@ safe-install: check-up-to-date check-forward-only build
 	@# Atomic-ish replace: copy to temp then move (move is atomic on same filesystem)
 	@cp $(BUILD_DIR)/$(BINARY) $(INSTALL_DIR)/$(BINARY).new
 	@mv $(INSTALL_DIR)/$(BINARY).new $(INSTALL_DIR)/$(BINARY)
-	@# Nuke any stale go-install binaries that shadow the canonical location
-	@for bad in $(HOME)/go/bin/$(BINARY) $(HOME)/bin/$(BINARY); do \
-		if [ -f "$$bad" ]; then \
-			echo "Removing stale $$bad (use make install, not go install)"; \
+	@# Nuke any stale binaries from previous install locations
+	@for bad in $(HOME)/go/bin/$(BINARY) $(HOME)/bin/$(BINARY) $(HOME)/.local/bin/$(BINARY); do \
+		if [ -f "$$bad" ] && [ "$$bad" != "$(INSTALL_DIR)/$(BINARY)" ]; then \
+			echo "Removing stale $$bad"; \
 			rm -f "$$bad"; \
 		fi; \
 	done
-- 
